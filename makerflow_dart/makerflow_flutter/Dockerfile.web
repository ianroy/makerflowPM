# MakerFlow PM — Flutter web demo bundle, served by nginx.
# Build context is makerflow_dart/ (the app path-depends on ../makerflow_client
# and ../makerflow_design), same as the server image.
#
#   docker build -f makerflow_flutter/Dockerfile.web \
#     --build-arg MAKERFLOW_API=https://<app-domain>/api/ makerflow_dart/
#
# On DigitalOcean App Platform, MAKERFLOW_API is injected as a build arg from
# the component env (scope RUN_AND_BUILD_TIME) — see ../.do/app.yaml.
ARG FLUTTER_VERSION=3.44.2
# Fallback if this exact tag is ever missing: instrumentisto/flutter:${FLUTTER_VERSION}
FROM ghcr.io/cirruslabs/flutter:${FLUTTER_VERSION} AS build
WORKDIR /src
COPY . .
ARG MAKERFLOW_API=http://localhost:8080/
RUN cd makerflow_flutter \
  && flutter pub get \
  && flutter build web --release \
       --dart-define=MAKERFLOW_LIVE=true \
       --dart-define=MAKERFLOW_API=${MAKERFLOW_API}

FROM nginx:1.27-alpine
COPY --from=build /src/makerflow_flutter/build/web /usr/share/nginx/html
COPY makerflow_flutter/deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
